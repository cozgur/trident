<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}</artifactId>
  <version>${version}</version>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <trident.version>${tridentVersion}</trident.version>
    <cucumber.version>7.22.1</cucumber.version>
    <junit.version>5.12.2</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <slf4j.version>2.0.17</slf4j.version>

    <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    <maven.failsafe.plugin.version>3.5.6</maven.failsafe.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Trident's own artifacts. Import this and you never write a Trident version again. -->
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-bom</artifactId>
        <version>${trident.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.ozgurcetintas.trident</groupId>
      <artifactId>trident-runner</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.ozgurcetintas.trident</groupId>
      <artifactId>trident-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.ozgurcetintas.trident</groupId>
      <artifactId>trident-web</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Pinned, not inherited from whatever Maven happens to default to. Maven 3.6's default
        compiler plugin is 3.1, which does not understand maven.compiler.release and fails
        asking for Java 5. Nothing about this project should depend on which Maven the reader
        has installed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <!-- A suite class matches none of Surefire's default *Test/Test* patterns. -->
          <includes>
            <include>**/*TestSuite.java</include>
          </includes>
          <failIfNoTests>true</failIfNoTests>
          <skipTests>${trident.skip.smoke.suite}</skipTests>
          <!--
            Tests run in a fixed locale. This is ordinary hygiene - a suite whose result depends
            on the developer's locale is not a suite - and here it is load-bearing: REST Assured
            lowercases its internal "FAILURE" handler key without a locale, so under tr_TR it
            looks up "faılure", finds nothing, and throws on every non-2xx instead of returning
            it. Measured: the same 400 returns normally under en_US and throws under tr_TR.
            It must be an argLine, not a systemPropertyVariable: Locale.getDefault() is fixed at
            JVM start.
          -->
          <argLine>-Duser.language=en -Duser.country=US</argLine>

          <systemPropertyVariables>
            <!--
              Maven project properties are not visible to the forked test JVM, so they are
              forwarded explicitly. The tag expression is composed rather than passed through:
              "@smoke and (...)" means this suite can never run an @api scenario, whatever
              ${trident.tags} is set to.
            -->
            <cucumber.filter.tags>@smoke and (${trident.tags})</cucumber.filter.tags>
            <!--
              Glue is per suite. Cucumber's @BeforeAll runs for every glue package a suite
              loads, so anything that starts a container must live in a package this suite does
              not list - otherwise the fast suite starts it too.
            -->
            <cucumber.glue>dev.ozgurcetintas.trident.runner, ${package}.steps</cucumber.glue>
            <cucumber.plugin>pretty, summary, message:target/cucumber-messages.ndjson</cucumber.plugin>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.failsafe.plugin.version}</version>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <!--
            Tests run in a fixed locale. This is ordinary hygiene - a suite whose result depends
            on the developer's locale is not a suite - and here it is load-bearing: REST Assured
            lowercases its internal "FAILURE" handler key without a locale, so under tr_TR it
            looks up "faılure", finds nothing, and throws on every non-2xx instead of returning
            it. Measured: the same 400 returns normally under en_US and throws under tr_TR.
            It must be an argLine, not a systemPropertyVariable: Locale.getDefault() is fixed at
            JVM start.
          -->
          <argLine>-Duser.language=en -Duser.country=US</argLine>
        </configuration>
        <executions>
          <!--
            One execution per suite, not one execution with two tags. Each gets its own
            includes, its own composed tag expression, its own glue, its own message log and its
            own reports directory - so a failure says which layer broke rather than "the
            integration suite".

            Each also carries its own summaryFile. Failsafe's verify goal reads the summary its
            integration-test goal wrote, and two executions sharing the default path would have
            the second overwrite the first.
          -->
          <execution>
            <id>api-suite</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/${prefix}IT.java</include>
              </includes>
              <skipITs>${trident.skip.api.suite}</skipITs>
              <reportsDirectory>target/failsafe-reports</reportsDirectory>
              <summaryFile>target/failsafe-reports/failsafe-summary-api.xml</summaryFile>
              <systemPropertyVariables>
                <cucumber.filter.tags>@api and (${trident.tags})</cucumber.filter.tags>
                <!-- Add your support package here when it holds glue, such as a container. -->
                <cucumber.glue>dev.ozgurcetintas.trident.runner, ${package}.steps</cucumber.glue>
                <cucumber.plugin>pretty, summary, message:target/failsafe-cucumber-messages.ndjson</cucumber.plugin>
              </systemPropertyVariables>
            </configuration>
          </execution>

          <execution>
            <id>web-suite</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/${prefix}WebIT.java</include>
              </includes>
              <skipITs>${trident.skip.web.suite}</skipITs>
              <reportsDirectory>target/failsafe-web-reports</reportsDirectory>
              <summaryFile>target/failsafe-web-reports/failsafe-summary-web.xml</summaryFile>
              <systemPropertyVariables>
                <cucumber.filter.tags>@web and (${trident.tags})</cucumber.filter.tags>
                <!--
                  The browser lifecycle has its own glue package. Cucumber runs hooks for every
                  glue package a suite loads, so a browser hook on the shared steps path would
                  open a browser for the api suite as well.
                -->
                <cucumber.glue>dev.ozgurcetintas.trident.runner, ${package}.websteps</cucumber.glue>
                <cucumber.plugin>pretty, summary, message:target/web-cucumber-messages.ndjson</cucumber.plugin>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <!--
    profile      tags        suite                 needs
    smoke        @smoke      Surefire only         nothing            (default)
    api          @api        Failsafe api-suite    your target
    web          @web        Failsafe web-suite    a browser
    regression   not @wip    Surefire only         nothing

    Every profile names every skip flag. A profile that leaves one unset inherits whatever was
    set last, which is how a suite ends up running in a profile that never meant to run it.
  -->
  <profiles>
    <profile>
      <id>smoke</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <trident.tags>@smoke</trident.tags>
        <trident.skip.smoke.suite>false</trident.skip.smoke.suite>
        <trident.skip.api.suite>true</trident.skip.api.suite>
        <trident.skip.web.suite>true</trident.skip.web.suite>
      </properties>
    </profile>
    <profile>
      <id>api</id>
      <properties>
        <trident.tags>@api</trident.tags>
        <trident.skip.smoke.suite>true</trident.skip.smoke.suite>
        <trident.skip.api.suite>false</trident.skip.api.suite>
        <trident.skip.web.suite>true</trident.skip.web.suite>
      </properties>
    </profile>
    <profile>
      <id>web</id>
      <properties>
        <trident.tags>@web</trident.tags>
        <trident.skip.smoke.suite>true</trident.skip.smoke.suite>
        <trident.skip.api.suite>true</trident.skip.api.suite>
        <trident.skip.web.suite>false</trident.skip.web.suite>
      </properties>
    </profile>
    <profile>
      <id>regression</id>
      <properties>
        <trident.tags>not @wip</trident.tags>
        <trident.skip.smoke.suite>false</trident.skip.smoke.suite>
        <trident.skip.api.suite>true</trident.skip.api.suite>
        <trident.skip.web.suite>true</trident.skip.web.suite>
      </properties>
    </profile>
  </profiles>

</project>
