<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.ozgurcetintas.trident</groupId>
    <artifactId>trident-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>trident-archetype</artifactId>
  <packaging>maven-archetype</packaging>

  <name>Trident Archetype</name>
  <description>Generates a consumer project wired to Trident: two suites, tag routing, and a first scenario that passes.</description>

  <properties>
    <!-- @ only: ${...} belongs to Velocity in archetype-resources. -->
    <maven.resources.delimiters>@</maven.resources.delimiters>
    <trident.skip.archetype.it>true</trident.skip.archetype.it>
  </properties>

  <build>
    <resources>
      <!--
        Only the descriptor is filtered, and only with @ delimiters, so that the archetype's
        own version reaches the generated project without Maven touching anything under
        archetype-resources - those files are Velocity templates full of ${...} that Maven
        must leave alone.
      -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>META-INF/maven/archetype-metadata.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>META-INF/maven/archetype-metadata.xml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <!--
        Generates a project from this archetype and runs `verify` on it, on every build. This is
        the continuous proof of the claim the archetype exists to make - that a generated
        project works with no editing - and it runs with parameters deliberately unlike the ones
        used while writing the template.

        Skipped by default, because the generated project resolves Trident from the local
        repository and `verify` runs before `install` has put this version there. CI installs
        first and then runs it with -Dtrident.skip.archetype.it=false, which is the only order
        in which it can mean anything.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-archetype-plugin</artifactId>
        <configuration>
          <skip>${trident.skip.archetype.it}</skip>
        </configuration>
      </plugin>
    </plugins>

    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>${archetype.packaging.version}</version>
      </extension>
    </extensions>
  </build>

</project>
