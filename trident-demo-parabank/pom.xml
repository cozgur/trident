<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.ozgurcetintas.trident</groupId>
    <artifactId>trident-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>trident-demo-parabank</artifactId>
  <packaging>jar</packaging>

  <name>Trident Demo: ParaBank</name>
  <description>Reference implementation against ParaBank. Not published.</description>

  <properties>
    <!--
      This module is the reference implementation, not a product. It shows what a consumer
      project looks like, so publishing it would invite someone to depend on a demo.
    -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.ozgurcetintas.trident</groupId>
      <artifactId>trident-runner</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.ozgurcetintas.trident</groupId>
      <artifactId>trident-api</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.ozgurcetintas.trident</groupId>
      <artifactId>trident-web</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-schema-validator</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    This build section is the pattern a consumer project copies. Nothing in it is specific to
    ParaBank; what is specific to a project is the tag names and the feature path.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- A suite class does not match Surefire's default *Test/Test* patterns. -->
          <includes>
            <include>**/*TestSuite.java</include>
            <!--
              Ordinary unit tests in this module, which is where the locator policy scanner
              lives. It reads the page-object sources and needs neither a browser nor a
              container, so the Docker-free run is the right place for it.
            -->
            <include>**/*Test.java</include>
          </includes>
          <failIfNoTests>true</failIfNoTests>
          <skipTests>${trident.skip.smoke.suite}</skipTests>
          <!--
            Tests run in a fixed locale. This is ordinary hygiene - a suite whose result depends
            on the developer's locale is not a suite - and here it is load-bearing: REST Assured
            lowercases its internal "FAILURE" handler key without a locale, so under tr_TR it
            looks up "faılure", finds nothing, and throws on every non-2xx instead of returning
            it. Measured: the same 400 returns normally under en_US and throws under tr_TR.
            It must be an argLine, not a systemPropertyVariable: Locale.getDefault() is fixed at
            JVM start.
          -->
          <argLine>-Duser.language=en -Duser.country=US</argLine>

          <systemPropertyVariables>
            <!--
              Maven project properties are not visible to the forked test JVM. Forwarding
              these explicitly is what makes the profiles take effect.

              The expression is composed rather than passed through: "@smoke and (...)"
              means this suite can never execute an @api scenario, whatever ${trident.tags}
              is set to. That is a structural guarantee, not a convention.
            -->
            <cucumber.filter.tags>@smoke and (${trident.tags})</cucumber.filter.tags>
            <!--
              No container package on this glue path. Cucumber's @BeforeAll runs for whatever
              glue a suite loads, so including the lifecycle here would start ParaBank for the
              Docker-free run and break the quickstart promise.
            -->
            <cucumber.glue>dev.ozgurcetintas.trident.runner, dev.ozgurcetintas.trident.demo.parabank.steps</cucumber.glue>
            <!-- Each suite writes its own message log; see junit-platform.properties. -->
            <cucumber.plugin>pretty, summary, message:target/cucumber-messages.ndjson</cucumber.plugin>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <!--
            Same fixed locale as the smoke suite above, for the same reason.
          -->
          <argLine>-Duser.language=en -Duser.country=US</argLine>
        </configuration>
        <executions>
          <!--
            Two executions, not one with two tags. Each suite gets its own includes, its own
            composed tag expression, its own glue, its own message log and its own reports
            directory. That last pair is what lets the execution gate say which layer failed:
            one log per suite, read independently. Sharing either would leave a failure
            reported against "the integration suite" with no way to tell a locator from an
            endpoint.

            Each execution also carries its own summaryFile. Failsafe's verify goal reads the
            summary its integration-test goal wrote, and two executions writing to the default
            path would have the second overwrite the first.
          -->
          <execution>
            <id>api-suite</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/ParaBankIT.java</include>
              </includes>
              <skipITs>${trident.skip.api.suite}</skipITs>
              <reportsDirectory>${project.build.directory}/failsafe-reports</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-reports/failsafe-summary-api.xml</summaryFile>
              <systemPropertyVariables>
                <!-- "@api and (...)": this suite can never execute a @smoke or @web scenario. -->
                <cucumber.filter.tags>@api and (${trident.tags})</cucumber.filter.tags>
                <!-- This suite adds the container lifecycle; the smoke suite has no container. -->
                <cucumber.glue>dev.ozgurcetintas.trident.runner, dev.ozgurcetintas.trident.demo.parabank.steps, dev.ozgurcetintas.trident.demo.parabank.container</cucumber.glue>
                <cucumber.plugin>pretty, summary, message:target/failsafe-cucumber-messages.ndjson</cucumber.plugin>
              </systemPropertyVariables>
            </configuration>
          </execution>

          <execution>
            <id>web-suite</id>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/ParaBankWebIT.java</include>
              </includes>
              <skipITs>${trident.skip.web.suite}</skipITs>
              <reportsDirectory>${project.build.directory}/failsafe-web-reports</reportsDirectory>
              <summaryFile>${project.build.directory}/failsafe-web-reports/failsafe-summary-web.xml</summaryFile>
              <systemPropertyVariables>
                <!-- "@web and (...)": this suite can never execute a @smoke or @api scenario. -->
                <cucumber.filter.tags>@web and (${trident.tags})</cucumber.filter.tags>
                <!--
                  The browser lifecycle sits in its own glue package. Cucumber's hooks run for
                  every glue package a suite loads, so a browser hook on the shared steps path
                  would open one for the api suite too - the same shape of defect that once
                  started a container for the Docker-free smoke run.
                -->
                <cucumber.glue>dev.ozgurcetintas.trident.runner, dev.ozgurcetintas.trident.demo.parabank.websteps, dev.ozgurcetintas.trident.demo.parabank.container</cucumber.glue>
                <cucumber.plugin>pretty, summary, message:target/web-cucumber-messages.ndjson</cucumber.plugin>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

</project>
