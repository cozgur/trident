<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    This POM deliberately does not inherit from trident-parent. It is Trident's public
    dependency contract, and an importing consumer receives the whole effective
    dependencyManagement of whatever it imports. Inheriting would hand consumers the
    parent's third-party alignment as well, so a bump of cucumber.version here would
    silently re-pin downstream builds. See docs/adr/0006-standalone-bom.md.

    The consequence is that the version below is literal and duplicated from the parent.
    Keep the two in step with:

        ./mvnw versions:set -DnewVersion=X -DprocessAllModules=true

    The flag is required, not optional. Without it versions:set does not reach a module that
    has no parent, and this POM silently keeps the old version while the rest of the reactor
    moves — publishing a released BOM that manages snapshot coordinates.
  -->
  <groupId>dev.ozgurcetintas.trident</groupId>
  <artifactId>trident-bom</artifactId>
  <version>0.2.1</version>
  <packaging>pom</packaging>

  <name>Trident BOM</name>
  <description>Bill of materials for consumers of Trident.</description>
  <url>https://github.com/cozgur/trident</url>

  <!--
    Central requires name, description, url, licenses, developers and scm on every published
    artifact. This POM has no parent (see docs/adr/0006-standalone-bom.md), so it cannot
    inherit them and carries its own copy. That is the third thing detaching the BOM costs,
    after the duplicated version and the duplicated plugin pin.
  -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>cozgur</id>
      <name>Ozgur Cetintas</name>
      <email>ozgur.cetintas@yahoo.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/cozgur/trident.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/cozgur/trident.git</developerConnection>
    <url>https://github.com/cozgur/trident</url>
    <tag>HEAD</tag>
  </scm>

  <dependencyManagement>
    <!--
      Import BOM for downstream consumer projects: import this with <scope>import</scope>
      to depend on Trident modules without declaring their versions.

      trident-demo-parabank is deliberately absent. The BOM manages publishable artifacts,
      and the demo is a reference implementation rather than a product: listing it here
      would invite a consumer to depend on ParaBank fixtures. It is a reactor module and
      nothing more, and its own POM sets maven.deploy.skip.
    -->
    <dependencies>
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-mobile</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-runner</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.ozgurcetintas.trident</groupId>
        <artifactId>trident-archetype</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!--
      This block exists solely to stop CLI-invoked plugin goals from resolving their version
      over the network inside this module. Because this POM does not inherit, it has no
      pluginManagement of its own, and a goal such as
      `mvn com.diffplug.spotless:spotless-maven-plugin:apply` run from the repository root
      would pick the latest release here while every other module used the pinned one.

      The version is literal: a standalone POM cannot reach the parent's spotless.version
      property. Bump it together with spotless.version in trident-parent.
    -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>2.44.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      Also not inherited. Signing is the only release step this POM needs - packaging is pom,
      so there are no sources or javadoc to attach - and the publishing plugin runs from the
      aggregator. Keep the versions in step with the parent's release profile.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <!--
            Also not inherited, and the dry run is how we found out: without this the default
            maven-deploy-plugin runs for this module instead, and the BOM never reaches the
            Portal at all. Keep the version and the server id in step with the parent's release
            profile. This is the fourth thing detaching the BOM costs.
          -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
