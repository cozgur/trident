<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.ozgurcetintas.trident</groupId>
  <artifactId>trident-parent</artifactId>
  <version>0.2.2</version>
  <packaging>pom</packaging>

  <name>Trident Parent</name>
  <description>Test automation framework for web, mobile and API testing behind a single Cucumber runner.</description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <url>https://github.com/cozgur/trident</url>

  <developers>
    <developer>
      <id>cozgur</id>
      <name>Ozgur Cetintas</name>
      <email>ozgur.cetintas@yahoo.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/cozgur/trident.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/cozgur/trident.git</developerConnection>
    <url>https://github.com/cozgur/trident</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>trident-bom</module>
    <module>trident-core</module>
    <module>trident-api</module>
    <module>trident-web</module>
    <module>trident-mobile</module>
    <module>trident-runner</module>
    <module>trident-demo-parabank</module>
    <module>trident-archetype</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Dependency versions. Every dependency version in this repository resolves here. -->
    <owner.version>1.0.12</owner.version>
    <cucumber.version>7.22.1</cucumber.version>
    <junit.version>5.12.2</junit.version>
    <rest.assured.version>6.0.1</rest.assured.version>
    <jackson.version>2.22.2</jackson.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <assertj.version>3.27.3</assertj.version>
    <slf4j.version>2.0.17</slf4j.version>

    <!-- Plugin versions. Every plugin version in this repository resolves here. -->
    <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
    <!--
      Surefire 3.5.3 is deliberately skipped: it reports "Tests run: 0" for a JUnit Platform
      @Suite even when the suite executes, which silently defeats failIfNoTests and the CI
      scenario-count gate. 3.5.2 and 3.5.4+ report correctly.
    -->
    <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    <maven.failsafe.plugin.version>3.5.6</maven.failsafe.plugin.version>
    <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
    <spotless.plugin.version>2.44.5</spotless.plugin.version>
    <maven.archetype.plugin.version>3.4.1</maven.archetype.plugin.version>
    <maven.gpg.plugin.version>3.2.8</maven.gpg.plugin.version>
    <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
    <maven.javadoc.plugin.version>3.12.0</maven.javadoc.plugin.version>
    <central.publishing.plugin.version>0.11.0</central.publishing.plugin.version>
    <archetype.packaging.version>3.4.1</archetype.packaging.version>
    <palantir.java.format.version>2.68.0</palantir.java.format.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.aeonbits.owner</groupId>
        <artifactId>owner-java8</artifactId>
        <version>${owner.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest.assured.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${rest.assured.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-simple</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <!--
          Failsafe is pinned here but deliberately left unbound: Phase 0 has no integration
          tests. Phase 1 binds it once Testcontainers-backed scenarios exist.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven.failsafe.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven.enforcer.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>${maven.archetype.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>21</version>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions/>
                <requireReleaseDeps>
                  <onlyWhenRelease>true</onlyWhenRelease>
                </requireReleaseDeps>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir.java.format.version}</version>
            </palantirJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    Each profile sets the tag expression and decides which of the two suites runs.
    trident-runner composes the expression per suite as "@smoke and (${trident.tags})" for
    Surefire and "@api and (${trident.tags})" for Failsafe, so a suite can never execute the
    other's scenarios whatever ${trident.tags} happens to be.

      profile      tags        suite           Docker
      smoke        @smoke      Surefire only   no    (default; the README quickstart)
      api          @api        Failsafe only   yes
      regression   not @wip    Surefire only   no

    regression is deliberately Surefire-only. It exists so a developer can run the full
    local suite with one command, and making Docker a prerequisite for that would turn it
    into a second api profile. Suite composition already limits "not @wip" to @smoke
    scenarios on the Surefire side. CI runs smoke and api as separate steps.
  -->
  <profiles>
    <profile>
      <id>smoke</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <trident.tags>@smoke</trident.tags>
        <trident.skip.smoke.suite>false</trident.skip.smoke.suite>
        <trident.skip.api.suite>true</trident.skip.api.suite>
      </properties>
    </profile>
    <profile>
      <id>api</id>
      <properties>
        <trident.tags>@api</trident.tags>
        <trident.skip.smoke.suite>true</trident.skip.smoke.suite>
        <trident.skip.api.suite>false</trident.skip.api.suite>
      </properties>
    </profile>
    <!--
      Signing, sources and javadoc live here and nowhere else. A local `verify` must never
      reach for a GPG key: a contributor without one would be unable to build, and a build that
      signs by accident is a build that can publish by accident.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven.source.plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven.javadoc.plugin.version}</version>
            <configuration>
              <!--
                trident-web and trident-mobile are placeholders holding a package-info and
                nothing else, and javadoc refuses that outright: "No public or protected classes
                found to document". Central accepts a placeholder javadoc jar for exactly this
                case, so the jar is still attached and the build does not stop. A module with
                real classes still fails here if its javadoc is broken, which is the behaviour
                worth keeping.
              -->
              <failOnError>false</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven.gpg.plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <!--
              No gpgArguments here on purpose. The plugin uses gpg-agent by default, which is
              what lets a maintainer sign locally with the agent's cached passphrase, and lets
              CI supply it through MAVEN_GPG_PASSPHRASE after the workflow has configured the
              agent to accept a loopback passphrase. Hardcoding a loopback pinentry mode breaks
              the first case: it disables pinentry, so an unattended local run has no way to
              ask and simply hangs.
            -->
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.publishing.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
              <!-- The reference implementation is not a product; see ADR 0008. It also sets
                   maven.deploy.skip, and this is the belt to that pair of braces. -->
              <excludeArtifacts>
                <excludeArtifact>trident-demo-parabank</excludeArtifact>
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>regression</id>
      <properties>
        <trident.tags>not @wip</trident.tags>
        <trident.skip.smoke.suite>false</trident.skip.smoke.suite>
        <trident.skip.api.suite>true</trident.skip.api.suite>
      </properties>
    </profile>
  </profiles>

</project>
